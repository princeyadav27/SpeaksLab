# Copy to .env.local (never commit .env.local) and fill in the values.

# ── Clerk authentication (https://dashboard.clerk.com → API keys) ────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk component routes (already wired in this app).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Where to land after sign-in/sign-up when the flow has no redirect of its own.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/practice/topic
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/practice/topic
NEXT_PUBLIC_CLERK_SIGN_OUT_FALLBACK_REDIRECT_URL=/

# ── Vercel Blob recording storage (https://vercel.com → Storage → Blob) ──────
# Created automatically in Vercel deployments when you attach a Blob store.
# Locally: create a store and paste its read-write token here.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── AI + transcription (unchanged, both optional) ────────────────────────────
NVIDIA_API_KEY=your_nvidia_api_key
# NVIDIA_MODEL=your_model_name

# Hosted transcription (recommended for Vercel): set the full endpoint and
# a key, e.g. Groq free tier (https://console.groq.com/):
# WHISPER_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# WHISPER_API_KEY=your_groq_api_key
# WHISPER_MODEL=whisper-large-v3-turbo
# WHISPER_LANGUAGE=en

# Alternative: free local Whisper. Used only when WHISPER_API_URL is NOT set.
# WHISPER_BINARY=whisper
# WHISPER_MODEL=small.en
# WHISPER_LANGUAGE=en
